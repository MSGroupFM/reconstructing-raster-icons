{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconstructing-raster-icons.local/schemas/acceptance-report/1.0.0",
  "title": "Acceptance report 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_kind", "schema_version", "model_version", "run_id", "created_at", "status", "accuracy_target", "iteration", "limit_state", "stop_reason", "target_met", "canonical_environment", "canonical_renderer", "hashes", "normalization", "viewport", "metrics", "components", "topology_nodes", "topology_facts", "uncertainty", "gates", "warnings", "limitations", "artifacts"],
  "properties": {
    "schema_kind": {"const": "acceptance-report"},
    "schema_version": {"const": "1.0.0"},
    "model_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "utc-date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "status": {"enum": ["non_canonical", "not_accepted", "incomplete", "accepted"]},
    "accuracy_target": {"type": "number", "exclusiveMinimum": 0, "maximum": 100, "multipleOf": 0.01},
    "iteration": {"type": "integer", "minimum": 0},
    "limit_state": {"enum": ["active", "reached", "stalled"]},
    "stop_reason": {"type": ["string", "null"], "enum": ["accepted", "stalled", "iteration_limit", "user_stopped", "error", null]},
    "target_met": {"type": "boolean"},
    "canonical_environment": {"type": "boolean"},
    "canonical_renderer": {"$ref": "#/$defs/canonical_renderer"},
    "hashes": {"$ref": "#/$defs/hashes"},
    "normalization": {"$ref": "#/$defs/normalization"},
    "foreground_color": {"type": "string", "pattern": "^(?:currentColor|#[0-9A-Fa-f]{6})$"},
    "viewport": {"$ref": "#/$defs/viewport"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component_metric"}},
    "topology_nodes": {"type": "array", "items": {"$ref": "#/$defs/topology_node"}},
    "topology_facts": {"type": "array", "items": {"$ref": "#/$defs/topology_fact"}},
    "uncertainty": {"$ref": "#/$defs/uncertainty"},
    "gates": {"$ref": "#/$defs/gates"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "accepted"}}},
      "then": {"properties": {"target_met": {"const": true}, "canonical_environment": {"const": true}, "gates": {"items": {"properties": {"state": {"const": "pass"}}}}}}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hashes": {"type": "object", "additionalProperties": false, "required": ["source", "map", "reference_mask", "uncertainty_mask", "candidate", "diagnostics"], "properties": {"source": {"$ref": "#/$defs/hash"}, "map": {"$ref": "#/$defs/hash"}, "reference_mask": {"$ref": "#/$defs/hash"}, "uncertainty_mask": {"$ref": "#/$defs/hash"}, "candidate": {"$ref": "#/$defs/hash"}, "diagnostics": {"$ref": "#/$defs/hash"}}},
    "normalization": {"type": "object", "additionalProperties": false, "required": ["foreground_polarity", "background_decision", "threshold", "estimator_basis", "estimator"], "properties": {"foreground_polarity": {"enum": ["dark", "light"]}, "background_decision": {"enum": ["transparent", "opaque", "explicit"]}, "threshold": {"const": 0.5}, "estimator_basis": {"enum": ["automatic", "explicit_override"]}, "estimator": {"$ref": "#/$defs/estimator"}, "explicit_overrides": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/explicit_overrides"}]}}, "allOf": [{"if": {"properties": {"estimator_basis": {"const": "explicit_override"}}}, "then": {"required": ["explicit_overrides"], "properties": {"explicit_overrides": {"type": "object"}}}}]},
    "estimator": {"type": "object", "additionalProperties": false, "required": ["background_luminance", "dark_foreground_luminance", "light_foreground_luminance", "border_variance", "dark_contrast", "light_contrast", "contrast"], "properties": {"background_luminance": {"type": "number", "minimum": 0, "maximum": 1}, "dark_foreground_luminance": {"type": "number", "minimum": 0, "maximum": 1}, "light_foreground_luminance": {"type": "number", "minimum": 0, "maximum": 1}, "border_variance": {"type": "number", "minimum": 0, "maximum": 1}, "dark_contrast": {"type": "number", "minimum": 0, "maximum": 1}, "light_contrast": {"type": "number", "minimum": 0, "maximum": 1}, "contrast": {"type": "number", "minimum": 0, "maximum": 1}}},
    "explicit_overrides": {"type": "object", "additionalProperties": false, "minProperties": 1, "required": ["background_luminance", "foreground_luminance", "reason", "confirmed", "confirmed_at"], "properties": {"background_luminance": {"type": "number", "minimum": 0, "maximum": 1}, "foreground_luminance": {"type": "number", "minimum": 0, "maximum": 1}, "reason": {"type": "string", "minLength": 1}, "confirmed": {"const": true}, "confirmed_at": {"type": "string", "format": "utc-date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"}}},
    "canonical_renderer": {"type": "object", "additionalProperties": false, "required": ["renderer_name", "renderer_version", "runtime_name", "runtime_version", "npm_integrity", "wasm_sha256", "loader_sha256", "profile"], "properties": {"renderer_name": {"const": "@resvg/resvg-wasm"}, "renderer_version": {"const": "2.6.2"}, "runtime_name": {"const": "node"}, "runtime_version": {"const": "22.14.0"}, "npm_integrity": {"const": "sha512-FqALmHI8D4o6lk/LRWDnhw95z5eO+eAa6ORjVg09YRR7BkcM6oPHU9uyC0gtQG5vpFLvgpeU4+zEAz2H8APHNw=="}, "wasm_sha256": {"const": "22bf6e9f9a100d972da0411a69c5ba504367fc1fa87b3b64e3f35e53926d2d70"}, "loader_sha256": {"const": "10170d02d816f02ec76f9bc095b01d9becf536e7b1e12e5aa616652c84b237a1"}, "profile": {"type": "object", "additionalProperties": false, "required": ["color_space", "background", "current_color", "shape_rendering", "text_rendering", "load_system_fonts", "fit_to", "crop"], "properties": {"color_space": {"const": "sRGB"}, "background": {"const": "transparent"}, "current_color": {"const": "#000000"}, "shape_rendering": {"const": 2}, "text_rendering": {"const": 2}, "load_system_fonts": {"const": false}, "fit_to": {"const": "max_side"}, "crop": {"const": false}}}}},
    "canonical_canvas": {"type": "object", "additionalProperties": false, "required": ["width", "height", "raster_width", "raster_height"], "properties": {"width": {"type": "number", "minimum": 1}, "height": {"type": "number", "minimum": 1}, "raster_width": {"type": "integer", "minimum": 64}, "raster_height": {"type": "integer", "minimum": 64}}},
    "viewport": {"type": "object", "additionalProperties": false, "required": ["aspect_ratio", "grid", "view_box", "fit_mode", "alignment", "canonical_canvas"], "properties": {"aspect_ratio": {"type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$", "format": "aspect-ratio-1-to-16"}, "grid": {"type": "integer", "enum": [16, 20, 24, 32, 48, 64, 128, 256, 512, 1024]}, "view_box": {"type": "array", "prefixItems": [{"const": 0}, {"const": 0}, {"type": "number", "minimum": 1}, {"type": "number", "minimum": 1}], "items": false}, "fit_mode": {"enum": ["contain", "cover", "stretch"]}, "alignment": {"enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"]}, "canonical_canvas": {"$ref": "#/$defs/canonical_canvas"}}},
    "score": {"type": "number", "minimum": 0, "maximum": 100},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["silhouette_raw", "silhouette", "contour_raw", "contour", "layout_raw", "layout", "topology_raw", "topology", "composite_raw", "composite"], "properties": {"silhouette_raw": {"$ref": "#/$defs/score"}, "silhouette": {"$ref": "#/$defs/score"}, "contour_raw": {"$ref": "#/$defs/score"}, "contour": {"$ref": "#/$defs/score"}, "layout_raw": {"$ref": "#/$defs/score"}, "layout": {"$ref": "#/$defs/score"}, "topology_raw": {"$ref": "#/$defs/score"}, "topology": {"$ref": "#/$defs/score"}, "composite_raw": {"$ref": "#/$defs/score"}, "composite": {"$ref": "#/$defs/score"}}},
    "component_metric": {"type": "object", "additionalProperties": false, "required": ["component_id", "layout_score", "expected_hole_count"], "properties": {"component_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "layout_score": {"$ref": "#/$defs/score"}, "expected_hole_count": {"type": "integer", "minimum": 0}}},
    "topology_node": {"type": "object", "additionalProperties": false, "required": ["component_id", "hole_count"], "properties": {"component_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "hole_count": {"type": "integer", "minimum": 0}}},
    "topology_fact": {"type": "object", "additionalProperties": false, "required": ["relation", "subject", "object"], "properties": {"relation": {"enum": ["contains", "overlaps", "touches", "paint_order"]}, "subject": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "object": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}}},
    "uncertainty": {"type": "object", "additionalProperties": false, "required": ["pixels", "canvas_fraction", "bbox_fraction"], "properties": {"pixels": {"type": "integer", "minimum": 0}, "canvas_fraction": {"type": "number", "minimum": 0, "maximum": 0.05}, "bbox_fraction": {"type": "number", "minimum": 0, "maximum": 1}}},
    "gates": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/gate"}, "allOf": [
      {"contains": {"properties": {"gate_id": {"const": "auto.svg.safe_subset"}}}, "minContains": 1, "maxContains": 1}, {"contains": {"properties": {"gate_id": {"const": "auto.svg.render"}}}, "minContains": 1, "maxContains": 1}, {"contains": {"properties": {"gate_id": {"const": "auto.integrity.hashes"}}}, "minContains": 1, "maxContains": 1}, {"contains": {"properties": {"gate_id": {"const": "auto.components.present"}}}, "minContains": 1, "maxContains": 1}, {"contains": {"properties": {"gate_id": {"const": "auto.topology.facts"}}}, "minContains": 1, "maxContains": 1}, {"contains": {"properties": {"gate_id": {"const": "auto.viewport.geometry"}}}, "minContains": 1, "maxContains": 1}, {"contains": {"properties": {"gate_id": {"const": "auto.primitives.constraints"}}}, "minContains": 1, "maxContains": 1}, {"contains": {"properties": {"gate_id": {"const": "auto.paths.integrity"}}}, "minContains": 1, "maxContains": 1}, {"contains": {"properties": {"gate_id": {"const": "auto.style.monochrome"}}}, "minContains": 1, "maxContains": 1},
      {"contains": {"properties": {"gate_id": {"const": "semantic.components.complete"}}}, "minContains": 1, "maxContains": 1}, {"contains": {"properties": {"gate_id": {"const": "semantic.connectivity"}}}, "minContains": 1, "maxContains": 1}, {"contains": {"properties": {"gate_id": {"const": "semantic.editability"}}}, "minContains": 1, "maxContains": 1}, {"contains": {"properties": {"gate_id": {"const": "semantic.visual_meaning"}}}, "minContains": 1, "maxContains": 1}, {"contains": {"properties": {"gate_id": {"const": "semantic.target_sizes"}}}, "minContains": 1, "maxContains": 1}, {"contains": {"properties": {"gate_id": {"const": "semantic.overlay_diff"}}}, "minContains": 1, "maxContains": 1}, {"contains": {"properties": {"gate_id": {"const": "semantic.ambiguities"}}}, "minContains": 1, "maxContains": 1}
    ]},
    "gate": {"type": "object", "additionalProperties": false, "required": ["gate_id", "kind", "state", "evidence", "evaluator", "evaluated_at"], "properties": {"gate_id": {"enum": ["auto.svg.safe_subset", "auto.svg.render", "auto.integrity.hashes", "auto.components.present", "auto.topology.facts", "auto.viewport.geometry", "auto.primitives.constraints", "auto.paths.integrity", "auto.style.monochrome", "semantic.components.complete", "semantic.connectivity", "semantic.editability", "semantic.visual_meaning", "semantic.target_sizes", "semantic.overlay_diff", "semantic.ambiguities"]}, "kind": {"enum": ["automatic", "semantic"]}, "state": {"enum": ["pass", "fail", "not_evaluated"]}, "evidence": {"$ref": "#/$defs/evidence"}, "evaluator": {"type": "string", "minLength": 1}, "evaluated_at": {"type": "string", "format": "utc-date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"}}, "allOf": [
      {"if": {"properties": {"gate_id": {"pattern": "^auto\\."}}}, "then": {"properties": {"kind": {"const": "automatic"}, "state": {"enum": ["pass", "fail"]}}}},
      {"if": {"properties": {"gate_id": {"pattern": "^semantic\\."}}}, "then": {"properties": {"kind": {"const": "semantic"}, "state": {"enum": ["pass", "fail", "not_evaluated"]}}}}
    ]},
    "evidence": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"basis": {"type": "string", "minLength": 1}, "artifact_id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"}, "sha256": {"$ref": "#/$defs/hash"}}, "anyOf": [{"required": ["basis"]}, {"required": ["artifact_id", "sha256"]}], "dependentRequired": {"artifact_id": ["sha256"], "sha256": ["artifact_id"]}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["logical_id", "sha256", "retention"], "properties": {"logical_id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"}, "sha256": {"$ref": "#/$defs/hash"}, "retention": {"enum": ["retained", "deleted"]}}}
  }
}
