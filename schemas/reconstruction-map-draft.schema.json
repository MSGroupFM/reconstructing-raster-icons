{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconstructing-raster-icons.local/schemas/reconstruction-map-draft/1.0.0",
  "title": "Reconstruction map draft 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_kind",
    "schema_version",
    "map_revision",
    "created_at",
    "source_sha256",
    "accuracy_target",
    "accuracy_confirmed",
    "normalization",
    "source_color_scope",
    "viewport",
    "canonical_canvas",
    "target_sizes",
    "components",
    "topology_facts",
    "semantic_facts",
    "geometry_constraints",
    "applicable_gates",
    "ambiguities",
    "user_confirmations",
    "refinement_limit"
  ],
  "properties": {
    "schema_kind": {
      "const": "reconstruction-map-draft"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "map_revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "utc-date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "source_sha256": {
      "$ref": "#/$defs/hash"
    },
    "accuracy_target": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100,
      "multipleOf": 0.01
    },
    "accuracy_confirmed": {
      "const": true
    },
    "foreground_color": {
      "type": "string",
      "pattern": "^(?:currentColor|#[0-9A-Fa-f]{6})$"
    },
    "normalization": {
      "$ref": "#/$defs/normalization"
    },
    "source_color_scope": {
      "$ref": "#/$defs/source_color_scope"
    },
    "viewport": {
      "$ref": "#/$defs/viewport"
    },
    "canonical_canvas": {
      "$ref": "#/$defs/canonical_canvas"
    },
    "target_sizes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "topology_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topology_fact"
      }
    },
    "semantic_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semantic_fact"
      }
    },
    "geometry_constraints": {
      "$ref": "#/$defs/geometry_constraints"
    },
    "applicable_gates": {
      "$ref": "#/$defs/applicable_gates"
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ambiguity"
      }
    },
    "user_confirmations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/confirmation"
      }
    },
    "refinement_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foreground_polarity",
        "background_decision",
        "threshold",
        "estimator_basis",
        "estimator"
      ],
      "properties": {
        "foreground_polarity": {
          "enum": [
            "dark",
            "light"
          ]
        },
        "background_decision": {
          "enum": [
            "transparent",
            "opaque",
            "explicit"
          ]
        },
        "threshold": {
          "const": 0.5
        },
        "estimator_basis": {
          "enum": [
            "automatic",
            "explicit_override"
          ]
        },
        "estimator": {
          "$ref": "#/$defs/estimator"
        },
        "explicit_overrides": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/explicit_overrides"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "estimator_basis": {
                "const": "explicit_override"
              }
            }
          },
          "then": {
            "required": [
              "explicit_overrides"
            ],
            "properties": {
              "explicit_overrides": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect_ratio",
        "grid",
        "view_box",
        "fit_mode",
        "alignment"
      ],
      "properties": {
        "aspect_ratio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$",
          "format": "aspect-ratio-1-to-16"
        },
        "grid": {
          "type": "integer",
          "enum": [
            16,
            20,
            24,
            32,
            48,
            64,
            128,
            256,
            512,
            1024
          ]
        },
        "view_box": {
          "type": "array",
          "prefixItems": [
            {
              "const": 0
            },
            {
              "const": 0
            },
            {
              "type": "number",
              "minimum": 1
            },
            {
              "type": "number",
              "minimum": 1
            }
          ],
          "items": false
        },
        "fit_mode": {
          "enum": [
            "contain",
            "cover",
            "stretch"
          ]
        },
        "alignment": {
          "enum": [
            "center",
            "top",
            "bottom",
            "left",
            "right",
            "top-left",
            "top-right",
            "bottom-left",
            "bottom-right"
          ]
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "svg_id",
        "paint_type",
        "mandatory",
        "weight",
        "source_mask_path",
        "geometry",
        "expected_hole_count",
        "applicable_gates"
      ],
      "properties": {
        "component_id": {
          "$ref": "#/$defs/id"
        },
        "svg_id": {
          "$ref": "#/$defs/id"
        },
        "paint_type": {
          "enum": [
            "fill",
            "stroke",
            "mixed"
          ]
        },
        "mandatory": {
          "type": "boolean"
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_mask_path": {
          "type": "string",
          "minLength": 1
        },
        "geometry": {
          "enum": [
            "line",
            "circle",
            "ellipse",
            "polygon",
            "organic",
            "mixed"
          ]
        },
        "expected_hole_count": {
          "type": "integer",
          "minimum": 0
        },
        "applicable_gates": {
          "$ref": "#/$defs/applicable_gates"
        }
      }
    },
    "topology_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "subject",
        "object"
      ],
      "properties": {
        "relation": {
          "enum": [
            "contains",
            "overlaps",
            "touches",
            "paint_order"
          ]
        },
        "subject": {
          "$ref": "#/$defs/id"
        },
        "object": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "semantic_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "subject",
        "object"
      ],
      "properties": {
        "relation": {
          "const": "connects"
        },
        "subject": {
          "$ref": "#/$defs/id"
        },
        "object": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "canonical_canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "raster_width",
        "raster_height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1
        },
        "height": {
          "type": "number",
          "minimum": 1
        },
        "raster_width": {
          "type": "integer",
          "minimum": 64
        },
        "raster_height": {
          "type": "integer",
          "minimum": 64
        }
      }
    },
    "estimator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background_luminance",
        "dark_foreground_luminance",
        "light_foreground_luminance",
        "border_variance",
        "dark_contrast",
        "light_contrast",
        "contrast"
      ],
      "properties": {
        "background_luminance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dark_foreground_luminance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "light_foreground_luminance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "border_variance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dark_contrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "light_contrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "contrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "explicit_overrides": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "required": ["background_luminance", "foreground_luminance", "reason", "confirmed", "confirmed_at"],
      "properties": {
        "background_luminance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "foreground_luminance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confirmed": {
          "const": true
        },
        "confirmed_at": {
          "type": "string",
          "format": "utc-date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        }
      }
    },
    "source_color_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "merge_to_monochrome"],
      "properties": {
        "classification": {
          "enum": ["monochrome", "meaningful_multicolor", "gradient", "intentional_transparency"]
        },
        "merge_to_monochrome": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/confirmation"}
          ]
        }
      }
    },
    "applicable_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "auto.svg.safe_subset",
          "auto.svg.render",
          "auto.integrity.hashes",
          "auto.components.present",
          "auto.topology.facts",
          "auto.viewport.geometry",
          "auto.primitives.constraints",
          "auto.paths.integrity",
          "auto.style.monochrome",
          "semantic.components.complete",
          "semantic.connectivity",
          "semantic.editability",
          "semantic.visual_meaning",
          "semantic.target_sizes",
          "semantic.overlay_diff",
          "semantic.ambiguities"
        ]
      }
    },
    "normalized_point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "geometry_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lines",
        "orthogonality",
        "parallelism",
        "endpoints",
        "radial",
        "symmetry",
        "strokes",
        "intentional_intersections",
        "minimum_intentional_gaps"
      ],
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component_id", "start", "end", "tolerance"],
            "properties": {
              "component_id": {"$ref": "#/$defs/id"},
              "start": {"$ref": "#/$defs/normalized_point"},
              "end": {"$ref": "#/$defs/normalized_point"},
              "tolerance": {"type": "number", "minimum": 0}
            }
          }
        },
        "orthogonality": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["first", "second", "tolerance"],
            "properties": {
              "first": {"$ref": "#/$defs/id"},
              "second": {"$ref": "#/$defs/id"},
              "tolerance": {"type": "number", "minimum": 0}
            }
          }
        },
        "parallelism": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["first", "second", "tolerance"],
            "properties": {
              "first": {"$ref": "#/$defs/id"},
              "second": {"$ref": "#/$defs/id"},
              "tolerance": {"type": "number", "minimum": 0}
            }
          }
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component_id",
              "start",
              "end",
              "tolerance"
            ],
            "properties": {
              "component_id": {
                "$ref": "#/$defs/id"
              },
              "start": {
                "$ref": "#/$defs/normalized_point"
              },
              "end": {
                "$ref": "#/$defs/normalized_point"
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "radial": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component_id",
              "geometry",
              "center",
              "tolerance"
            ],
            "properties": {
              "component_id": {
                "$ref": "#/$defs/id"
              },
              "geometry": {
                "enum": [
                  "circle",
                  "ellipse"
                ]
              },
              "center": {
                "$ref": "#/$defs/normalized_point"
              },
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "radius_x": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "radius_y": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              }
            },
            "oneOf": [
              {
                "properties": {
                  "geometry": {
                    "const": "circle"
                  }
                },
                "required": [
                  "radius"
                ],
                "not": {
                  "anyOf": [
                    {"required": ["radius_x"]},
                    {"required": ["radius_y"]}
                  ]
                }
              },
              {
                "properties": {
                  "geometry": {
                    "const": "ellipse"
                  }
                },
                "required": [
                  "radius_x",
                  "radius_y"
                ],
                "not": {
                  "required": ["radius"]
                }
              }
            ]
          }
        },
        "symmetry": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component_id",
              "axis_start",
              "axis_end",
              "tolerance"
            ],
            "properties": {
              "component_id": {
                "$ref": "#/$defs/id"
              },
              "axis_start": {
                "$ref": "#/$defs/normalized_point"
              },
              "axis_end": {
                "$ref": "#/$defs/normalized_point"
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "strokes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component_id",
              "expected_width",
              "cap",
              "join"
            ],
            "properties": {
              "component_id": {
                "$ref": "#/$defs/id"
              },
              "expected_width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "cap": {
                "enum": [
                  "butt",
                  "round",
                  "square"
                ]
              },
              "join": {
                "enum": [
                  "miter",
                  "round",
                  "bevel"
                ]
              }
            }
          }
        },
        "intentional_intersections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "first",
              "second"
            ],
            "properties": {
              "first": {
                "$ref": "#/$defs/id"
              },
              "second": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "minimum_intentional_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "first",
              "second",
              "minimum_gap"
            ],
            "properties": {
              "first": {
                "$ref": "#/$defs/id"
              },
              "second": {
                "$ref": "#/$defs/id"
              },
              "minimum_gap": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ambiguity_id",
        "reason",
        "decision",
        "user_confirmation"
      ],
      "properties": {
        "ambiguity_id": {
          "$ref": "#/$defs/id"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "user_confirmation": {
          "$ref": "#/$defs/confirmation"
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "confirmed",
        "confirmed_at"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "confirmed": {
          "const": true
        },
        "confirmed_at": {
          "type": "string",
          "format": "utc-date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        }
      }
    }
  }
}
