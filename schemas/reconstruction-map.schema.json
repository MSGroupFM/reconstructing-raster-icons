{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconstructing-raster-icons.local/schemas/reconstruction-map/1.0.0",
  "title": "Frozen reconstruction map 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_kind", "schema_version", "map_revision", "created_at", "frozen_at", "source_sha256", "accuracy_target", "normalization", "viewport", "target_sizes", "components", "topology_facts", "semantic_facts", "geometry_constraints", "reference_mask", "uncertainty_mask", "refinement_limit"],
  "properties": {
    "schema_kind": {"const": "reconstruction-map"},
    "schema_version": {"const": "1.0.0"},
    "map_revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "frozen_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "source_sha256": {"$ref": "#/$defs/hash"},
    "accuracy_target": {"type": "number", "exclusiveMinimum": 0, "maximum": 100, "multipleOf": 0.01},
    "normalization": {"$ref": "#/$defs/normalization"},
    "viewport": {"$ref": "#/$defs/viewport"},
    "target_sizes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
    "topology_facts": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "semantic_facts": {"type": "array", "items": {"$ref": "#/$defs/semantic_relation"}},
    "geometry_constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
    "reference_mask": {"$ref": "#/$defs/artifact"},
    "uncertainty_mask": {"$ref": "#/$defs/artifact"},
    "refinement_limit": {"type": "integer", "minimum": 1, "maximum": 20}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["logical_id", "sha256"], "properties": {"logical_id": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "normalization": {"type": "object", "additionalProperties": false, "required": ["foreground_polarity", "background_decision", "threshold", "estimator_basis"], "properties": {"foreground_polarity": {"enum": ["dark", "light"]}, "background_decision": {"enum": ["transparent", "opaque", "explicit"]}, "threshold": {"const": 0.5}, "estimator_basis": {"enum": ["automatic", "explicit_override"]}}},
    "viewport": {"type": "object", "additionalProperties": false, "required": ["aspect_ratio", "grid", "view_box", "fit_mode", "alignment"], "properties": {"aspect_ratio": {"type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$", "format": "aspect-ratio-1-to-16"}, "grid": {"type": "integer", "enum": [16, 20, 24, 32, 48, 64, 128, 256, 512, 1024]}, "view_box": {"type": "array", "prefixItems": [{"const": 0}, {"const": 0}, {"type": "number", "minimum": 1}, {"type": "number", "minimum": 1}], "items": false}, "fit_mode": {"enum": ["contain", "cover", "stretch"]}, "alignment": {"enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"]}}},
    "component": {"type": "object", "additionalProperties": false, "required": ["component_id", "svg_id", "paint_type", "mandatory", "weight", "reference_mask", "geometry", "bbox", "centroid", "area"], "properties": {"component_id": {"$ref": "#/$defs/id"}, "svg_id": {"$ref": "#/$defs/id"}, "paint_type": {"enum": ["fill", "stroke", "mixed"]}, "mandatory": {"type": "boolean"}, "weight": {"type": "number", "exclusiveMinimum": 0}, "reference_mask": {"$ref": "#/$defs/artifact"}, "geometry": {"enum": ["line", "circle", "ellipse", "polygon", "organic", "mixed"]}, "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0}}, "centroid": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0}}, "area": {"type": "number", "exclusiveMinimum": 0}}},
    "relation": {"type": "object", "additionalProperties": false, "required": ["relation", "subject", "object"], "properties": {"relation": {"enum": ["contains", "overlaps", "touches", "paint_order"]}, "subject": {"$ref": "#/$defs/id"}, "object": {"$ref": "#/$defs/id"}}},
    "semantic_relation": {"type": "object", "additionalProperties": false, "required": ["relation", "subject", "object"], "properties": {"relation": {"const": "connects"}, "subject": {"$ref": "#/$defs/id"}, "object": {"$ref": "#/$defs/id"}}},
    "constraint": {"type": "object", "additionalProperties": false, "required": ["component_id", "kind", "tolerance"], "properties": {"component_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["endpoint", "radial", "symmetry", "stroke", "intersection", "gap"]}, "tolerance": {"type": "number", "minimum": 0}}}
  }
}
